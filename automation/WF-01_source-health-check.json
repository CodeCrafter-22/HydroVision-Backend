    {
      "parameters": {
        "jsCode": "const cwc = $('Probe_CWC').first() || {};\nconst openMeteo = $('Probe_OpenMeteo').first() || {};\nconst nasaGpm = $('Probe_NASAGPM').first() || {};\n\nconst now = new Date().toISOString();\n\nfunction evaluateSource(name, item) {\n  // Catch network failures or timeout errors\n  if (!item || !item.json || item.error || item.json.error) {\n    return {\n      source_name: name,\n      status: 'failed',\n      latency_ms: 0,\n      last_successful_fetch: null,\n      error_message: item?.error?.message || item?.json?.error || 'HTTP Request Failed',\n      updated_at: now\n    };\n  }\n\n  const statusCode = item.json.statusCode || 200;\n  const latency = item.json.latency || 250;\n\n  // Enforce strict health rules: status cannot be healthy solely because workflow ran\n  if (statusCode === 200 && latency < 3000) {\n    return {\n      source_name: name,\n      status: 'healthy',\n      latency_ms: latency,\n      last_successful_fetch: now,\n      error_message: null,\n      updated_at: now\n    };\n  } else if (statusCode === 200 && latency >= 3000) {\n    return {\n      source_name: name,\n      status: 'degraded',\n      latency_ms: latency,\n      last_successful_fetch: now,\n      error_message: 'Latency exceeded threshold',\n      updated_at: now\n    };\n  } else {\n    return {\n      source_name: name,\n      status: 'failed',\n      latency_ms: latency,\n      last_successful_fetch: null,\n      error_message: `HTTP Status ${statusCode}`,\n      updated_at: now\n    };\n  }\n}\n\nreturn [\n  { json: evaluateSource('cwc_gauge', cwc) },\n  { json: evaluateSource('open_meteo', openMeteo) },\n  { json: evaluateSource('nasa_gpm', nasaGpm) }\n];"
      },
