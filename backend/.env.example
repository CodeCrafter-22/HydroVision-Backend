# ==============================================================================
# HydroVision Backend - Environment Configuration Template
# ==============================================================================
# IMPORTANT:
# 1. Do NOT put real secrets in this template file!
# 2. Copy this file to '.env' locally: Copy-Item .env.example .env
# 3. Fill in your actual local/development credentials in your local '.env'.
# 4. Never commit your '.env' file to Git!
# ==============================================================================

# Application Settings
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
API_V1_PREFIX=/api/v1

# Security & CORS Settings
# Comma-separated list of allowed origins (e.g. Svi's frontend dev server)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Supabase Project Configuration (Placeholders only)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
# Private server-side key - NEVER expose to frontend or git!
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Direct PostgreSQL / PostGIS Connection String
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# Simulation & Safety Guardrails
# Safety rule: Simulated alerts MUST NOT be dispatched to real citizens unless explicitly set to true.
ALLOW_SIM_DELIVERY=false

# External Source Ingestion Settings (Placeholders for upcoming phases)
CWC_API_BASE_URL=https://cwc.gov.in/api/v1
OPEN_METEO_BASE_URL=https://flood-api.open-meteo.com/v1

# Ingestion Worker Authentication & WF-03 Failure Notification Webhook
INGESTION_WORKER_TOKEN=your-random-ingestion-worker-token
WF03_CALLBACK_URL=https://n8n.your-domain.com/webhook/wf03-failure