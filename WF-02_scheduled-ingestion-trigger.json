        "jsCode": "const items = $input.all();\n\n// Find CWC health status\nconst cwcRecord = items.find(item => item.json.source_name === 'cwc_gauge');\nconst openMeteoRecord = items.find(item => item.json.source_name === 'open_meteo');\n\nlet selectedSource = 'cwc_gauge';\nlet isFallback = false;\n\n// If CWC is not healthy, route to Open-Meteo fallback\nif (!cwcRecord || cwcRecord.json.status !== 'healthy') {\n  selectedSource = 'open_meteo';\n  isFallback = true;\n}\n\nreturn [{\n  json: {\n    active_source: selectedSource,\n    is_fallback: isFallback,\n    triggered_at: new Date().toISOString()\n  }\n}];"
